// Challenge 2
@550 = ~Erstes Steinfragment~
@551 = ~Zweites Steinfragment~
@552 = ~Drittes Steinfragment~
@553 = ~Eine Steinscherbe, die zu einem Symbol von Mask gehört.

EIGENSCHAFTEN:

Gewicht: 1~

@555 = ~Zusammengesetztes Symbol von Mask~
@556 = ~Das zusammengesetzte Symbol von Mask. Es wird benötigt, um die Prüfung abzuschließen.

EIGENSCHAFTEN:

Gewicht: 3~

@560 = ~Lasst Euch nicht stören.~

@570 = ~Ihr entdeckt ein Steinfragment unter dem Felsen.~
@571 = ~Ihr findet nichts von Bedeutung unter dem Felsen.~
@572 = ~Der Felsen bewegt sich nicht.~
@573 = ~Ihr seid zu weit entfernt, um das zu benutzen.~

@575 = ~Steinfragment von <CHARNAME> gestohlen.~
@576 = ~Steinfragment aufgenommen.~
@577 = ~Steinfragment abgelegt.~

@580 = ~Die Steinfragmente verwandeln sich in das Symbol von Mask. Benutzt es, um die Prüfung abzuschließen.~

// Challenge 3
// Hints from the rogues about their position in the hit order (1 to 9):
// not at position 1
@600 = ~Ich bin nicht der Erste.~
// not at position 9
@601 = ~Ich bin nicht der Letzte.~
// at odd-numbered position (1, 3, 5, 7, or 9)
@602 = ~Ich kann mich nicht halbieren.~ // Alternativ: Ich mag es ungerade.
// at even-numbered position (2, 4, 6, or 8)
@603 = ~Ich lasse alles gerade sein.~   // Alternativ: Ich besitze eine gerade Statur.
// position is prime number (2, 3, 5, or 7)
@604 = ~Man kann mich nicht teilen.~    // Alternativ: Ich mag Primzahlen.
// position is NOT a prime number (1, 4, 6, 8, or 9)
@605 = ~Man kann mich teilen.~          // Alternativ: Ich mag keine Primzahlen.
// position is a squared number (1, 4, or 9)
@606 = ~Ich bin quadratisch, praktisch und gut.~
// center position (5)
@607 = ~Ich stehe im Mittelpunkt der Aufmerksamkeit.~
// lower half of the sequence (1, 2, 3, or 4)
@608 = ~Ich gehöre der ersten Hälfte an.~
// upper half of the sequence (6, 7, 8, or 9)
@609 = ~Ich gehöre der zweiten Hälfte an.~

@610 = ~Wartet, bis sich unser Gefährte wieder beruhigt hat.~
@611 = ~Ihr habt das falsche Ziel erwischt. Das werdet Ihr mir büßen!~
@612 = ~Ich habe mich wieder beruhigt.~
@613 = ~Schurke Nummer <A7_CH3_POS> wurde erlöst.~

