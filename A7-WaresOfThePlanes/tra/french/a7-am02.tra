// dialog lines
// conversable items
@300 = ~Une voix résonne dans votre tête : « Affronte mes épreuves pour débloquer mes pouvoirs. »~
@301 = ~Je suis prêt.~~Je suis prête.~
@302 = ~Ranger le masque.~
@303 = ~Une voix résonne dans votre tête : « Tu n'es pas digne de mes pouvoirs. »~
@304 = ~Tu n'es pas encore assez fort pour me défier.~
@305 = ~Le masque est léger, mais très solide. Vous ressentez un léger picotement lorsque vous passez vos doigts sur la surface de l’artefact.~
@306 = ~Alors que vous concentrez vos pensées sur le masque, celui-ci émet une faible lueur et vous percevez un murmure lointain dans votre tête.~

// Challenges
@400 = ~Tu es entré dans les Épreuves du Masque, suppliant. Surmonte mes défis pour débloquer mes pouvoirs.~
@401 = ~Pour le premier défi, j’ai préparé un duel à un contre un avec l’un de mes Élus. Bats-le pour remporter ma récompense.~
@402 = ~Le deuxième défi mettra tes réflexes à l’épreuve. Trouve les trois parties d’une clé pour remporter ma récompense. Mais prends garde ! L’un de mes Élus tentera de te les arracher si tu ne fais pas attention.~
@403 = ~Le troisième et dernier défi met à l'épreuve ton sens de l'observation, ta perspicacité et ta persévérance. Les Neuf sont la clé si tu les trouves tous dans le bon ordre. Parle-leur pour obtenir des indices sur leur position dans l'ordre.~
@404 = ~Il n'y a plus de défis disponibles pour toi.~

// Challenge 1
@500 = ~Alors que vous êtes mortellement blessé, tout devient flou devant vos yeux et vous perdez connaissance.~~Alors que vous êtes mortellement blessée, tout devient flou devant vos yeux et vous perdez connaissance.~

// Challenge 2
@550 = ~Premier fragment de pierre~
@551 = ~Deuxième fragment de pierre~
@552 = ~Troisième fragment de pierre~
@553 = ~Un éclat de pierre provenant d'un symbole de Mask.

STATISTIQUES :

Poids : 1~

@555 = ~Symbole de Mask~
@556 = ~Le symbole de Mask ré-assemblé. Il est nécessaire pour terminer le défi.

STATISTIQUES :

Poids : 3~

@560 = ~Ne faites pas attention à moi.~
@561 = ~« Errer sans but ne vous mènera nulle part. »~
@562 = ~« Faites-vous vraiment des efforts ? Cherchez mieux ! Les trésors ne sont pas toujours à la vue de tous. »~
@563 = ~« Vous êtes une déception. Comment pouvez-vous vous considérer comme un voleur si vous n'êtes même pas capable de trouver des trésors qui traînent par terre ? »~

@570 = ~Vous découvrez un fragment de pierre sous le rocher.~
@571 = ~Vous ne trouvez rien d'intéressant sous le rocher.~
@572 = ~Le rocher ne bouge pas d'un pouce.~
@573 = ~Vous êtes trop loin pour l'utiliser.~

@575 = ~Fragment de pierre volé à <CHARNAME>.~
@576 = ~Fragment de pierre trouvé.~
@577 = ~Fragment de pierre jeté.~

@580 = ~Les fragments de pierre se sont assemblés pour former le symbole de Mask. Utilisez-les pour valider le défi.~

// Challenge 3
// Hints from the rogues about their position in the hit order (1 to 9):
// not at position 1
@600 = ~Je ne suis pas le premier.~
// not at position 9
@601 = ~Je ne suis pas le dernier.~
// at odd-numbered position (1, 3, 5, 7, or 9)
@602 = ~Je commets un impair en te parlant~
// at even-numbered position (2, 4, 6, or 8)
@603 = ~Je fais la paire avec mes confrères.~
// position is prime number (2, 3, 5, or 7)
@604 = ~je suis indivisible.~
// position is NOT a prime number (1, 4, 6, 8, or 9)
@605 = ~je suis divisible.~
// position is a squared number (1, 4, or 9)
@606 = ~Je suis carré avec toi.~
// center position (5)
@607 = ~Je suis le centre de l'attention.~
// lower half of the sequence (1, 2, 3, or 4)
@608 = ~J'appartiens à la classe inférieure.~
// upper half of the sequence (6, 7, 8, or 9)
@609 = ~J'appartiens à la classe supérieure.~

@610 = ~Attendez que votre compagnon voleur se calme.~
@611 = ~Tu t'es trompé de cible. Je te le ferai payer !~
@612 = ~Je me suis calmé.~
@613 = ~Voleur numéro <A7_CH3_POS> renvoyé.~

