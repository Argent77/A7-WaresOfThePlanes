  // adding area trigger
  COPY_EXISTING ~ar5500.are~ ~override~
    LPF fj_are_structure
      INT_VAR
        fj_type = 0
        fj_box_left = 3223
        fj_box_top = 2330
        fj_box_right = 3229
        fj_box_bottom = 2334
        fj_cursor_idx = 0
        fj_flags = BIT1 // trap resets
        fj_trap_active = 1
        fj_loc_x = 3226
        fj_loc_y = 2332
        fj_vertex_0 = 3223 | (2334 << 16)
        fj_vertex_1 = 3229 | (2334 << 16)
        fj_vertex_2 = 3226 | (2330 << 16)
      STR_VAR
        fj_structure_type = ~region~
        fj_name = ~a7-harmonium_trigger~
        fj_reg_script = ~a7-hmtrg~
    END
  BUT_ONLY
END
