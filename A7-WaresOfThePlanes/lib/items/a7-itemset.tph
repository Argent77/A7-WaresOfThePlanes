  Global("A7-HarmoniumQuest","GLOBAL",0)
  !Global("A7-SarinSetEquipped","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("A7-HarmoniumQuest","GLOBAL",1)
    SetGlobalTimer("A7-HarmoniumQuestTimer","GLOBAL",ONE_DAY)
    Continue()
