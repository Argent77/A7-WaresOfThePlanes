  GlobalTimerExpired("A7-HarmoniumQuestTimer","GLOBAL")
  !Global("Enclave","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("A7-HarmoniumQuest","GLOBAL",2)
    Continue()
END

