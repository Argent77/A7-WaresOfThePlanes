// Eyes of Mask: Challenge 3 Rogue common behavior

// Hit reaction while mismatch is active
IF
  HitBy([GOODCUTOFF],0)
  !Allegiance(Myself,ENEMY)
  !Global("a7-ch3_hostile","MYAREA",0)
THEN
  RESPONSE #100
    DisplayStringHead(Myself,@610)  // Wait for our fellow rogue to calm down.
END

IF
  HitBy([GOODCUTOFF],0)
  Allegiance(Myself,ENEMY)
  !Global("a7-ch3_hostile","MYAREA",0)
THEN
  RESPONSE #100
    Continue()
END

// Hit reaction: Match
IF
  HitBy([GOODCUTOFF],0)
  Global("a7-ch3_current_index","MYAREA",1)
  Global("index","LOCALS",1)
  Global("disabled","LOCALS",0)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("disabled","LOCALS",1)
    SetTokenGlobal("a7-ch3_current_index","MYAREA","A7_CH3_POS")
    DisplayString(Myself,@613)  // Rogue number <A7_CH3_POS> released.
    IncrementGlobal("a7-ch3_current_index","MYAREA",1)
    CreateVisualEffectObject("ICRMPARI",Myself)
    SmallWait(10)
    Deactivate(Myself)
    SetInterrupt(TRUE)
END

