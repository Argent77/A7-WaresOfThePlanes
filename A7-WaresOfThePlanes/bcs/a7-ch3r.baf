    IncrementGlobal("a7-ch3_current_index","MYAREA",1)
    CreateVisualEffectObject("ICRMPARI",Myself)
    SmallWait(10)
    DestroySelf()
    SetInterrupt(TRUE)
END

// Hit reaction: NOT match
IF
  HitBy([GOODCUTOFF],0)
  Global("disabled","LOCALS",0)
  !Allegiance(Myself,ENEMY)
THEN
  RESPONSE #100
    SetGlobal("a7-ch3_hostile","MYAREA",1)
    SetGlobalTimer("hostile_timer","LOCALS",TWO_ROUNDS)
    DisplayStringHead(Myself,@611)  // You've hit the wrong target. I'll get you for that!
    Enemy()
END

IF
  GlobalTimerExpired("hostile_timer","LOCALS")
  Allegiance(Myself,ENEMY)
THEN
  RESPONSE #100
    SetGlobal("a7-ch3_hostile","MYAREA",0)
    ChangeEnemyAlly(Myself,GOODBUTRED)
    DisplayStringHead(Myself,@612)  // I've calmed down.
END

// Default actions
IF
  Allegiance(Myself,ENEMY)
  See([PC])
THEN
  RESPONSE #100
    AttackReevaluate(LastSeenBy(Myself),15)
END

IF
  Allegiance(Myself,ENEMY)
  OR(2)
    See([FAMILIAR])
    See([CONTROLLED])
THEN
  RESPONSE #100
    AttackReevaluate(LastSeenBy(Myself),15)
END

IF
  True()
THEN
  RESPONSE #50
    RandomWalk()
  RESPONSE #25
    RandomTurn()
  RESPONSE #25
    NoAction()
END
