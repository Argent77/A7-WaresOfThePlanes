  See(NearestEnemyOf(Myself))
  Range(LastSeenBy(Myself),8)
  HaveSpell(WARRIOR_WHIRLWIND)
  RandomNum(2,1)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
