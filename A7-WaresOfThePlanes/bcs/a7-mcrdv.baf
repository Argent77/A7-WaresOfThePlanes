IF
  ActionListEmpty()
  AttackedBy([ANYONE],DEFAULT)
THEN
  RESPONSE #100
    Attack(LastAttackerOf(Myself))
END

IF
  ActionListEmpty()
THEN
  RESPONSE #100
    RandomWalk()
  RESPONSE #50
    NoAction()
END
